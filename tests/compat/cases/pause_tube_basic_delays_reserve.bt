# pause-tube: a waiting reserver on a paused tube is only served after the
# pause delay elapses. The pause and the sleep before the final recv are
# wide so a loaded machine can neither end the pause early nor outlast the recv timeout.
@c1 send "pause-tube default 3\r\n"
@c1 recv
@c2 send "reserve\r\n"
sleep 200ms
@c1 send "put 0 0 60 5\r\nhello\r\n"
@c1 recv
@c2 recv_none 800ms
sleep 2500ms
@c2 recv
