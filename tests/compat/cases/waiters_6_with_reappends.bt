# reserve: 6 blocked waiters, jobs one at a time with two served workers re-entering the queue midway.
@w1 send "list-tube-used\r\n"
@w1 recv
@w2 send "list-tube-used\r\n"
@w2 recv
@w3 send "list-tube-used\r\n"
@w3 recv
@w4 send "list-tube-used\r\n"
@w4 recv
@w5 send "list-tube-used\r\n"
@w5 recv
@w6 send "list-tube-used\r\n"
@w6 recv
@p send "list-tube-used\r\n"
@p recv
@w1 send "reserve\r\n"
sleep 50ms
@w2 send "reserve\r\n"
sleep 50ms
@w3 send "reserve\r\n"
sleep 50ms
@w4 send "reserve\r\n"
sleep 50ms
@w5 send "reserve\r\n"
sleep 50ms
@w6 send "reserve\r\n"
sleep 50ms
@p send "put 0 0 60 2\r\nj1\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 2\r\nj2\r\n"
@p recv
sleep 50ms
@w1 recv
@w2 recv
@w1 send "reserve\r\n"
sleep 50ms
@w2 send "reserve\r\n"
sleep 50ms
@p send "put 0 0 60 2\r\nj3\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 2\r\nj4\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 2\r\nj5\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 2\r\nj6\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 2\r\nj7\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 2\r\nj8\r\n"
@p recv
sleep 50ms
@w1 recv
@w2 recv
@w3 recv
@w4 recv
@w5 recv
@w6 recv
