# a waiter holding a reserved job half-closes: it gets TIMED_OUT and still holds its job until it closes.
@p send "put 0 0 60 1\r\nx\r\n"
@p recv
@h send "reserve\r\n"
@h recv
@h send "reserve\r\n"
sleep 100ms
@h shutdown_write
@h recv
@p send "stats-job 1\r\n"
@p recv
@h close
sleep 200ms
@p send "stats-job 1\r\n"
@p recv
