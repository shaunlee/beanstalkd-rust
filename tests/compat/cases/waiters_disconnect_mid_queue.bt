# reserve: a waiter in the middle of the queue disconnects; remaining waiters are served in the resulting order.
@w1 send "list-tube-used\r\n"
@w1 recv
@w2 send "list-tube-used\r\n"
@w2 recv
@w3 send "list-tube-used\r\n"
@w3 recv
@w4 send "list-tube-used\r\n"
@w4 recv
@p send "list-tube-used\r\n"
@p recv
@w1 send "reserve\r\n"
sleep 50ms
@w2 send "reserve\r\n"
sleep 50ms
@w3 send "reserve\r\n"
sleep 50ms
@w4 send "reserve\r\n"
sleep 50ms
@w2 close
sleep 500ms
@p send "stats\r\n"
@p recv
@p send "put 0 0 60 2\r\nj1\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 2\r\nj2\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 2\r\nj3\r\n"
@p recv
sleep 50ms
@w1 recv
@w3 recv
@w4 recv
