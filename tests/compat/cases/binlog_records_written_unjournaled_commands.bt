# commands that are not journaled leave binlog-records-written unchanged: reserve, touch, release 0, peek*, stats*, use/watch/ignore, pause-tube, list-*, delay expiry, rejected commands.
!binlog
@a send "put 0 0 1 1\r\na\r\n"
@a recv
@a send "put 0 2 60 1\r\nb\r\n"
@a recv
@a send "stats\r\n"
@a recv
@a send "reserve\r\n"
@a recv
@a send "touch 1\r\n"
@a recv
@a send "release 1 3 0\r\n"
@a recv
@a send "peek 1\r\n"
@a recv
@a send "peek-ready\r\n"
@a recv
@a send "peek-delayed\r\n"
@a recv
@a send "peek-buried\r\n"
@a recv
@a send "use foo\r\n"
@a recv
@a send "watch bar\r\n"
@a recv
@a send "ignore bar\r\n"
@a recv
@a send "pause-tube default 1\r\n"
@a recv
@a send "list-tubes\r\n"
@a recv
@a send "stats-tube default\r\n"
@a recv
@a send "stats-job 1\r\n"
@a recv
@a send "delete 99\r\n"
@a recv
@a send "bury 1 0\r\n"
@a recv
@a send "kick-job 1\r\n"
@a recv
@a send "stats\r\n"
@a recv
sleep 2800ms
@a send "reserve-with-timeout 0\r\n"
@a recv
@a send "stats-job 1\r\n"
@a recv
@a send "stats-job 2\r\n"
@a recv
@a send "stats\r\n"
@a recv
