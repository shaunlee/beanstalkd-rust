# a bury acknowledged before a SIGKILL persists with its new priority; the buried job is not handed out after restart.
!binlog
@a send "put 100 0 60 1\r\na\r\n"
@a recv
@a send "reserve\r\n"
@a recv
@a send "bury 1 3\r\n"
@a recv
crash
@a send "stats-job 1\r\n"
@a recv
@a send "reserve-with-timeout 0\r\n"
@a recv
@a send "peek-buried\r\n"
@a recv
