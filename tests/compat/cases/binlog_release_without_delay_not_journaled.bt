# release with delay 0 is not journaled: a new priority set by it is lost on restart and records-written does not move; release with a delay is journaled.
!binlog
@a send "put 5 0 60 1\r\nx\r\n"
@a recv
@a send "reserve\r\n"
@a recv
@a send "release 1 9 0\r\n"
@a recv
@a send "stats\r\n"
@a recv
@a send "stats-job 1\r\n"
@a recv
restart
@a send "stats-job 1\r\n"
@a recv
@a send "reserve\r\n"
@a recv
@a send "release 1 11 1\r\n"
@a recv
@a send "stats\r\n"
@a recv
crash 1800ms
@a send "stats-job 1\r\n"
@a recv
