# touch: postpones a job's TTR expiry, measured from the moment touch runs.
# Without the touch at t=3s, a ttr=5s job reserved at t=0 would already be
# back in the ready queue by t=6s; touch resets the deadline to t=8s. The 2s
# margins on each side keep a loaded machine from crossing a boundary.
@c1 send "put 0 0 5 5\r\nhello\r\n"
@c1 recv
@c1 send "reserve\r\n"
@c1 recv
sleep 3000ms
@c1 send "touch 1\r\n"
@c1 recv
sleep 3000ms
@c1 send "stats-job 1\r\n"
@c1 recv
