# reserve: a waiter that watches two tubes is swap-removed from the other tube's wait queue when served, reordering that queue.
@w1 send "watch a\r\n"
@w1 recv
@w2 send "list-tube-used\r\n"
@w2 recv
@w3 send "list-tube-used\r\n"
@w3 recv
@w4 send "list-tube-used\r\n"
@w4 recv
@p send "list-tube-used\r\n"
@p recv
@w1 send "reserve\r\n"
sleep 50ms
@w2 send "reserve\r\n"
sleep 50ms
@w3 send "reserve\r\n"
sleep 50ms
@w4 send "reserve\r\n"
sleep 50ms
@p send "use a\r\n"
@p recv
@p send "put 0 0 60 5\r\nfroma\r\n"
@p recv
@w1 recv
@p send "use default\r\n"
@p recv
@p send "put 0 0 60 2\r\nd1\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 2\r\nd2\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 2\r\nd3\r\n"
@p recv
sleep 50ms
@w2 recv
@w3 recv
@w4 recv
