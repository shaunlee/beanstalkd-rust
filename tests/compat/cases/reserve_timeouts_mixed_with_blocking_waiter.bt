# two reserve-with-timeout waiters time out while a plain reserve waiter keeps waiting and gets the later put.
@w1 send "list-tube-used\r\n"
@w1 recv
@w2 send "list-tube-used\r\n"
@w2 recv
@w3 send "list-tube-used\r\n"
@w3 recv
@p send "list-tube-used\r\n"
@p recv
@w1 send "reserve-with-timeout 1\r\n"
sleep 50ms
@w2 send "reserve\r\n"
sleep 50ms
@w3 send "reserve-with-timeout 1\r\n"
sleep 1500ms
@w1 recv
@w3 recv
@p send "stats-tube default\r\n"
@p recv
@p send "put 0 0 60 1\r\nx\r\n"
@p recv
@w2 recv
