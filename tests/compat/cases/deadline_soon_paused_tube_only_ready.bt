# DEADLINE_SOON: the only ready job sits in a paused watched tube, so reserve starts waiting and gets DEADLINE_SOON from the next tick.
@c1 send "use p\r\n"
@c1 recv
@c1 send "put 0 0 60 6\r\npaused\r\n"
@c1 recv
@c1 send "pause-tube p 10\r\n"
@c1 recv
@c1 send "watch p\r\n"
@c1 recv
@c1 send "use default\r\n"
@c1 recv
@c1 send "put 0 0 1 5\r\nshort\r\n"
@c1 recv
@c1 send "reserve\r\n"
@c1 recv
@c1 send "reserve\r\n"
@c1 recv
@c1 send "stats\r\n"
@c1 recv
