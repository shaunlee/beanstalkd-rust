# reserve: 5 blocked waiters, jobs arriving one at a time; ms_take round-robin decides who gets which job.
@w1 send "list-tube-used\r\n"
@w1 recv
@w2 send "list-tube-used\r\n"
@w2 recv
@w3 send "list-tube-used\r\n"
@w3 recv
@w4 send "list-tube-used\r\n"
@w4 recv
@w5 send "list-tube-used\r\n"
@w5 recv
@p send "list-tube-used\r\n"
@p recv
@w1 send "reserve\r\n"
sleep 50ms
@w2 send "reserve\r\n"
sleep 50ms
@w3 send "reserve\r\n"
sleep 50ms
@w4 send "reserve\r\n"
sleep 50ms
@w5 send "reserve\r\n"
sleep 50ms
@p send "put 0 0 60 4\r\njob1\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 4\r\njob2\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 4\r\njob3\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 4\r\njob4\r\n"
@p recv
sleep 50ms
@p send "put 0 0 60 4\r\njob5\r\n"
@p recv
sleep 50ms
@w1 recv
@w2 recv
@w3 recv
@w4 recv
@w5 recv
