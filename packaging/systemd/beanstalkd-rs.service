# systemd unit for beanstalkd-rs.
#
# Install:
#   useradd --system --user-group --home-dir /var/lib/beanstalkd-rs \
#       --shell /usr/sbin/nologin beanstalkd
#   install -m 0755 beanstalkd-rs /usr/local/bin/beanstalkd-rs
#   install -d -m 0755 /etc/beanstalkd-rs
#   install -m 0644 packaging/examples/binlog.toml /etc/beanstalkd-rs/config.toml
#   install -m 0644 packaging/systemd/beanstalkd-rs.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now beanstalkd-rs
#
# Any file in packaging/examples/ can serve as config.toml. Keep the binlog
# (binlog.dir) or the cluster data (cluster.data_dir) under
# /var/lib/beanstalkd-rs: it is the only path the service may write.
#
# There is no ExecReload: beanstalkd-rs does not reload its configuration
# (SIGHUP is not handled); apply changes with `systemctl restart`.

[Unit]
Description=beanstalkd-rs work queue
Documentation=https://github.com/shaunlee/beanstalkd-rust
After=network-online.target
Wants=network-online.target

[Service]
# Type=notify would need sd_notify support, which the server does not have.
Type=simple
User=beanstalkd
Group=beanstalkd
ExecStart=/usr/local/bin/beanstalkd-rs --config /etc/beanstalkd-rs/config.toml
# SIGTERM is a graceful shutdown: stop accepting, sync the binlog, exit 0.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=2s
# Status 10 means another process holds the binlog directory lock, and
# status 11 that the cluster removed this node (it exits once a quorum of
# the remaining voters confirms it); restarting cannot fix either. A node
# that exits with 11 stays failed until its unit is disabled.
RestartPreventExitStatus=10 11
# One descriptor per client connection.
LimitNOFILE=65536

# Writable state: /var/lib/beanstalkd-rs, created and owned by User=.
StateDirectory=beanstalkd-rs
StateDirectoryMode=0750
ReadWritePaths=/var/lib/beanstalkd-rs
UMask=0027

# Hardening. Ports below 1024 would additionally need
# AmbientCapabilities=CAP_NET_BIND_SERVICE and the same capability in
# CapabilityBoundingSet=.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
# Signal delivery uses socketpair(), which this does not restrict.
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A filtered call fails with EPERM instead of killing the process, so the
# best-effort RLIMIT_NOFILE raise at startup cannot take the server down.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
